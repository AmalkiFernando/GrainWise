      },
      "source": [
        "## Tuning\n",
        "**Trees are not scaled** — `scale=False`. Tree splits compare a feature against a threshold, so monotone rescaling changes nothing. Scaling a forest is harmless but signals you did not think about it.\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "69AfTbEYRrJz",
        "outputId": "94834bd1-647e-42db-ed82-5d440492e5da"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Best params: {'model__max_depth': 6, 'model__max_features': 'sqrt', 'model__min_samples_leaf': 10, 'model__n_estimators': 400}\n",
            "Inner-CV ROC-AUC: 0.9784   <- tuning score, NOT reported\n"
          ]
        }
      ],
      "source": [
        "from sklearn.ensemble import RandomForestClassifier\n",
        "\n",
        "grid = {\"model__n_estimators\": [200, 400],\n",
        "        \"model__max_depth\": [None, 6, 12],\n",
        "        \"model__min_samples_leaf\": [1, 3, 10],\n",
        "        \"model__max_features\": [\"sqrt\", 0.5]}\n",
        "\n",
        "gs = GridSearchCV(rs.make_pipeline(RandomForestClassifier(random_state=rs.RANDOM_STATE, n_jobs=-1), scale=False),\n",
        "                  grid, cv=rs.INNER_CV, scoring=\"roc_auc\", n_jobs=-1)\n",
        "gs.fit(X_train, y_train)\n",
        "\n",
        "print(\"Best params:\", gs.best_params_)\n",
        "print(f\"Inner-CV ROC-AUC: {gs.best_score_:.4f}   <- tuning score, NOT reported\")"
      ]
    },
